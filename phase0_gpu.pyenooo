
from pathlib import Path
import os
os.environ["CODECARBON_LOG_LEVEL"] = "ERROR"

from codecarbon import EmissionsTracker
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM, pipeline

Path("emissions").mkdir(parents=True, exist_ok=True)

with EmissionsTracker(project_name="phase0-mac", output_dir="./emissions") as tracker:
    model_id = "google/flan-t5-small"
    tok = AutoTokenizer.from_pretrained(model_id)
    model = AutoModelForSeq2SeqLM.from_pretrained(model_id).to("cuda")
    summarizer = pipeline("summarization", model=model, tokenizer=tok, device=0)

    inputs = [
        "Harika and her teammate plan to meet at 5 PM in the CS lab to install Ubuntu and verify Git.",
        "Alice asks Bob to grab lunch after class at 1 PM; they agree to meet in the cafeteria.",
        "Professor assigns a sustainable AI project measuring energy/emissions while keeping accuracy acceptable."
    ]
    outputs = summarizer(inputs, max_length=60, min_length=10, truncation=True)
    for i, out in enumerate(outputs, 1):
        print(f"\n--- Sample {i} ---"
        print("SUMMARY:", out["summary_text"])
