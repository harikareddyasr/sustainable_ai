import argparse
import os
import time
import random
from typing import Any, Dict, List, Tuple

import torch
import pandas as pd
from codecarbon import EmissionsTracker
from transformers import (
    AutoTokenizer,
    AutoModelForSeq2SeqLM,
    AutoModelForQuestionAnswering,
    BitsAndBytesConfig,
)

from utils.datasets import load_summarization_data, load_qa_data, load_reasoning_data
from utils.metrics import rouge_like, f1_for_qa


# -------------------------
# 0) GPU-only + stable attention backend
# -------------------------
def require_cuda() -> str:
    if not torch.cuda.is_available():
        raise RuntimeError("CUDA is required (GPU-only), but torch.cuda.is_available() is False.")
    return "cuda"

def set_seed(seed: int):
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

def configure_attention_backend():
    """
    Prevent SDPA CUDA kernel issues on some setups (e.g., T4) by forcing math/eager path.
    This does NOT change your experiment design; it only avoids a runtime crash.
    """
    try:
        torch.backends.cuda.enable_flash_sdp(False)
    except Exception:
        pass
    try:
        torch.backends.cuda.enable_mem_efficient_sdp(False)
    except Exception:
        pass
    try:
        torch.backends.cuda.enable_math_sdp(True)
    except Exception:
        pass

def is_hf_dataset(obj: Any) -> bool:
    return hasattr(obj, "shuffle") and hasattr(obj, "select") and hasattr(obj, "__len__")

def select_subset(data: Any, max_samples: int, seed: int):
    if max_samples is None or max_samples <= 0:
        return data
    n = len(data)
    k = min(max_samples, n)
    if is_hf_dataset(data):
        return data.shuffle(seed=seed).select(range(k))
    data_list = list(data)
    rng = random.Random(seed)
    rng.shuffle(data_list)
    return data_list[:k]

def get_max_input_len(tokenizer, model, fallback: int = 512) -> int:
    m = getattr(getattr(model, "config", None), "max_position_embeddings", None)
    if isinstance(m, int) and m > 0:
        return m
    t = getattr(tokenizer, "model_max_length", None)
    if isinstance(t, int) and 0 < t < 100000:
        return t
    return fallback


# -------------------------
# 1) Model loader (fp32/fp16/int8/int4)
# -------------------------
def load_model_and_tokenizer(task: str, model_name: str, quantization: str):
    if task in ("summarization", "reasoning"):
        ModelCls = AutoModelForSeq2SeqLM
    elif task == "qa":
        ModelCls = AutoModelForQuestionAnswering
    else:
        raise ValueError(f"Unsupported task: {task}")

    tokenizer = AutoTokenizer.from_pretrained(model_name)

    # Ensure padding token exists (safe)
    if tokenizer.pad_token is None and tokenizer.eos_token is not None:
        tokenizer.pad_token = tokenizer.eos_token

    # For fp32/fp16 force eager attention to avoid SDPA kernel path
    eager_kwargs = {"attn_implementation": "eager"}

    if quantization == "fp32":
        model = ModelCls.from_pretrained(model_name, **eager_kwargs)
        model.to("cuda")
    elif quantization == "fp16":
        model = ModelCls.from_pretrained(model_name, **eager_kwargs)
        model.to("cuda", dtype=torch.float16)
    elif quantization == "int8":
        bnb = BitsAndBytesConfig(load_in_8bit=True)
        model = ModelCls.from_pretrained(
            model_name,
            quantization_config=bnb,
            device_map="cuda:0",
        )
    elif quantization == "int4":
        bnb = BitsAndBytesConfig(
            load_in_4bit=True,
            bnb_4bit_quant_type="nf4",
            bnb_4bit_compute_dtype=torch.float16,
            bnb_4bit_use_double_quant=True,
        )
        model = ModelCls.from_pretrained(
            model_name,
            quantization_config=bnb,
            device_map="cuda:0",
        )
    else:
        raise ValueError("quantization must be one of: fp32, fp16, int8, int4")

    model.eval()
    return tokenizer, model


# -------------------------
# 2) Task inference (NO emissions here)
# -------------------------
@torch.no_grad()
def summarization_infer(tokenizer, model, data, quantization: str) -> Tuple[float, float]:
    scores, latencies = [], []
    use_autocast = (quantization == "fp16")
    max_len = get_max_input_len(tokenizer, model, fallback=1024)

    for ex in data:
        inputs = tokenizer(
            ex["input"],
            return_tensors="pt",
            truncation=True,
            max_length=max_len,
            padding=False,
        ).to("cuda")

        start = time.time()
        if use_autocast:
            with torch.autocast(device_type="cuda", dtype=torch.float16):
                out_ids = model.generate(**inputs, max_new_tokens=64)
        else:
            out_ids = model.generate(**inputs, max_new_tokens=64)
        latencies.append(time.time() - start)

        pred = tokenizer.decode(out_ids[0], skip_special_tokens=True)
        scores.append(rouge_like(pred, ex["reference"]))

    return float(sum(scores) / len(scores)), float(sum(latencies) / len(latencies))


@torch.no_grad()
def qa_infer(tokenizer, model, data) -> Tuple[float, float]:
    scores, latencies = [], []
    max_len = get_max_input_len(tokenizer, model, fallback=512)

    for ex in data:
        inputs = tokenizer(
            ex["question"],
            ex["context"],
            return_tensors="pt",
            truncation=True,
            max_length=max_len,
            padding=False,
        ).to("cuda")

        start = time.time()
        outputs = model(**inputs)
        latencies.append(time.time() - start)

        start_logits = outputs.start_logits[0]
        end_logits = outputs.end_logits[0]
        s = torch.argmax(start_logits).item()
        e = torch.argmax(end_logits).item()
        if e < s:
            e = s

        tokens = tokenizer.convert_ids_to_tokens(inputs["input_ids"][0])
        pred = tokenizer.convert_tokens_to_string(tokens[s : e + 1])
        scores.append(f1_for_qa(pred, ex["answer"]))

    return float(sum(scores) / len(scores)), float(sum(latencies) / len(latencies))


def _extract_choice_letter(text: str) -> str:
    t = (text or "").strip().upper()
    for ch in t:
        if ch in ("A", "B", "C", "D", "E"):
            return ch
    return ""


@torch.no_grad()
def reasoning_infer(tokenizer, model, data, quantization: str) -> Tuple[float, float]:
    correct = 0
    latencies = []
    use_autocast = (quantization == "fp16")
    max_len = get_max_input_len(tokenizer, model, fallback=1024)

    for ex in data:
        inputs = tokenizer(
            ex["prompt"],
            return_tensors="pt",
            truncation=True,
            max_length=max_len,
            padding=False,
        ).to("cuda")

        start = time.time()
        if use_autocast:
            with torch.autocast(device_type="cuda", dtype=torch.float16):
                out_ids = model.generate(**inputs, max_new_tokens=8)
        else:
            out_ids = model.generate(**inputs, max_new_tokens=8)
        latencies.append(time.time() - start)

        pred = tokenizer.decode(out_ids[0], skip_special_tokens=True)
        pred_letter = _extract_choice_letter(pred)
        gold = (ex["label"] or "").strip().upper()
        if pred_letter == gold:
            correct += 1

    acc = correct / len(data)
    return float(acc), float(sum(latencies) / len(latencies))


# -------------------------
# 3) Inference-only emissions + repeats
# -------------------------
def run_config(
    task: str,
    model_name: str,
    quantization: str,
    repeats: int,
    base_seed: int,
    max_eval_samples: int,
):
    os.makedirs("emissions", exist_ok=True)

    # Load dataset (NOT counted)
    if task == "summarization":
        full_data = load_summarization_data(split="validation")
        dataset_name = "xsum"
    elif task == "qa":
        full_data = load_qa_data(split="validation")
        dataset_name = "squad"
    elif task == "reasoning":
        full_data = load_reasoning_data(split="validation")
        dataset_name = "arc_challenge"
    else:
        raise ValueError(f"Unsupported task: {task}")

    # Load model (NOT counted)
    tokenizer, model = load_model_and_tokenizer(task, model_name, quantization)

    # Warmup (NOT counted)
    warm = select_subset(full_data, max_samples=min(10, max_eval_samples), seed=base_seed + 999)
    if task == "summarization":
        summarization_infer(tokenizer, model, warm, quantization)
    elif task == "qa":
        qa_infer(tokenizer, model, warm)
    else:
        reasoning_infer(tokenizer, model, warm, quantization)

    run_rows: List[Dict[str, Any]] = []

    for r in range(repeats):
        seed = base_seed + r
        set_seed(seed)
        data = select_subset(full_data, max_samples=max_eval_samples, seed=seed)

        tracker = EmissionsTracker(
            project_name="sustainable-ai-inference",
            output_dir="emissions",
            save_to_file=True,
        )

        start_time = time.time()
        tracker.start()

        if task == "summarization":
            metric, avg_latency = summarization_infer(tokenizer, model, data, quantization)
            metric_name = "rouge_like"
        elif task == "qa":
            metric, avg_latency = qa_infer(tokenizer, model, data)
            metric_name = "f1"
        else:
            metric, avg_latency = reasoning_infer(tokenizer, model, data, quantization)
            metric_name = "accuracy"

        emissions_kg = tracker.stop()
        wall_time = time.time() - start_time

        row = {
            "task": task,
            "dataset": dataset_name,
            "model_name": model_name,
            "quantization": quantization,
            "device": "cuda",
            "repeat_id": r,
            "seed": seed,
            "num_samples": len(data),
            "metric_name": metric_name,
            "metric_value": metric,
            "avg_latency_sec": avg_latency,
            "inference_wall_time_sec": wall_time,
            "emissions_kg": emissions_kg,
        }
        print("[RUN]", row)
        run_rows.append(row)

        df_run = pd.DataFrame([row])
        if os.path.exists("experiments_runs.csv"):
            df_run.to_csv("experiments_runs.csv", mode="a", header=False, index=False)
        else:
            df_run.to_csv("experiments_runs.csv", index=False)

    # Aggregate mean/std
    df = pd.DataFrame(run_rows)

    def mean_std(x: pd.Series) -> str:
        m = x.mean()
        s = x.std(ddof=1) if len(x) > 1 else 0.0
        return f"{m:.6f} ± {s:.6f}"

    agg = {
        "task": task,
        "dataset": dataset_name,
        "model_name": model_name,
        "quantization": quantization,
        "device": "cuda",
        "repeats": repeats,
        "num_samples": int(df["num_samples"].iloc[0]),
        "metric_name": df["metric_name"].iloc[0],
        "metric_mean_std": mean_std(df["metric_value"]),
        "latency_mean_std": mean_std(df["avg_latency_sec"]),
        "emissions_mean_std": mean_std(df["emissions_kg"]),
        "inference_time_mean_std": mean_std(df["inference_wall_time_sec"]),
    }
    print("[AGG]", agg)

    df_agg = pd.DataFrame([agg])
    if os.path.exists("experiments_agg.csv"):
        df_agg.to_csv("experiments_agg.csv", mode="a", header=False, index=False)
    else:
        df_agg.to_csv("experiments_agg.csv", index=False)


# -------------------------
# 4) CLI
# -------------------------
def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--task", type=str, required=True, choices=["summarization", "qa", "reasoning"])
    p.add_argument("--model_name", type=str, required=True)
    p.add_argument("--quantization", type=str, default="fp32", choices=["fp32", "fp16", "int8", "int4"])
    p.add_argument("--repeats", type=int, default=10)
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--max_eval_samples", type=int, default=1000)
    return p.parse_args()


def main():
    require_cuda()
    configure_attention_backend()
    args = parse_args()
    run_config(
        task=args.task,
        model_name=args.model_name,
        quantization=args.quantization,
        repeats=args.repeats,
        base_seed=args.seed,
        max_eval_samples=args.max_eval_samples,
    )


if __name__ == "__main__":
    main()
